{
  "name": "manwhatrack",
  "private": true,
  "version": "1.0.0",
  "description": "Local-only Chrome extension that automatically tracks manhwa reading.",
  "keywords": [
    "chrome-extension",
    "manhwa",
    "manga",
    "webtoon",
    "reading-tracker",
    "local-first",
    "manifest-v3"
  ],
  "homepage": "https://github.com/desenyon/ManwhaTrack#readme",
  "bugs": {
    "url": "https://github.com/desenyon/ManwhaTrack/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/desenyon/ManwhaTrack.git"
  },
  "license": "MIT",
  "author": "Naitik Gupta",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/build.mjs && playwright test",
    "check": "npm run typecheck && npm run test && npm run build",
    "package": "node scripts/build.mjs && node scripts/package.mjs",
    "launch": "node scripts/build.mjs && node scripts/launch.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.3.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
